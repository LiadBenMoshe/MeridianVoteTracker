# Copy to .env and fill in. .env is git-ignored: no keys or connection strings live in the code.
# Option: put any of these in Azure Key Vault instead (secret name uses "--", e.g. ConnectionStrings--Meridian)
# and set only KeyVault__Uri + the AZURE_* identity below.

# ---------- Azure Database for PostgreSQL (main database) ----------
ConnectionStrings__Meridian=Host=<server>.postgres.database.azure.com;Port=5432;Database=meridian;Username=<user>;Password=<password>;Ssl Mode=Require;Trust Server Certificate=true

# Or, with no password (Microsoft Entra login of your own user, see "Entra identity" below):
# ConnectionStrings__Meridian=Host=<server>.postgres.database.azure.com;Port=5432;Database=postgres;Username=<you>@<tenant>.onmicrosoft.com;Ssl Mode=Require
# Database__Auth=Entra

# ---------- Azure Blob Storage (uploaded CSV / PDF files) ----------
Storage__Provider=AzureBlob
# Either a container SAS URL (no account keys; Portal → Storage browser → container → Generate SAS → "User delegation key")
Storage__ContainerSasUrl=https://<account>.blob.core.windows.net/uploads?sv=...&sig=...
# ...or the account URL + Entra identity (needs "Storage Blob Data Contributor"):
# Storage__AccountUrl=https://<account>.blob.core.windows.net
# ...or a connection string with an account key:
# Storage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
Storage__Container=uploads

# ---------- Entra identity (used by Database__Auth=Entra and Storage__AccountUrl) ----------
# Default = managed identity / AZURE_* service principal / VS login. In Docker on a dev machine use DeviceCode:
# the API log prints a code to enter at https://microsoft.com/devicelogin (`docker compose logs -f api`).
# Azure__Credential=DeviceCode
# Azure__TenantId=<tenant>.onmicrosoft.com

# ---------- Azure AI Document Intelligence (bonus: scanned PDFs) ----------
DocumentIntelligence__Endpoint=https://<resource>.cognitiveservices.azure.com/
DocumentIntelligence__Key=<key>   # leave empty to use the Entra identity (role: Cognitive Services User)

# ---------- Application Insights (central logs + request tracing) ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------- Azure Key Vault (optional) ----------
# Secret names in the vault ("--" = ":"; "_" is not allowed in names):
#   ConnectionStrings--Meridian, Storage--ConnectionString,
#   DocumentIntelligence--Endpoint, DocumentIntelligence--Key, ApplicationInsights--ConnectionString
KeyVault__Uri=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------- Offline alternative: `docker compose --profile local up` ----------
# ConnectionStrings__Meridian=Host=postgres;Database=meridian;Username=meridian;Password=meridian-local
# Storage__Provider=Local
